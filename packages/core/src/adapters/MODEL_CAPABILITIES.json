  "provider_defaults": {
    "note": "For agents whose adapters pass through any model (OpenRouter, Ollama, OpenAI-compatible endpoints), use these provider-level defaults",
    "openrouter": {
      "vision_support": "per-model (check model card; models with 'vision' tag support images)",
      "token_limit": 131072,
      "supports_streaming": true,
      "supports_function_calling": "per-model"
    },
    "ollama": {
      "vision_support": "per-model (llava, llava-llama3, bakllava, minicpm-v support vision)",
