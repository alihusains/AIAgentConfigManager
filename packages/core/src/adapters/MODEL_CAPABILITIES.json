{
  "metadata": {
    "title": "Model Capabilities Database — vision, tokens, pricing",
    "date": "2026-09-03",
    "scope": "All named models referenced across the 23 adapter-backed agents in A5-MODEL-ADAPTERS-MAPPING.json",
    "notes": [
      "Prices are list prices in USD per 1M tokens, from official provider pricing pages as of 2026-09-03.",
      "token_limit is the context window (input+output) in tokens where the provider documents one.",
      "supports_reasoning marks models with a dedicated reasoning/thinking budget (o-series, R1, DeepSeek-R1, Gemini thinking mode).",
      "supports_function_calling and supports_tools are effectively the same capability on modern APIs; both are recorded where the API distinguishes them.",
      "training_data_cutoff is null where the vendor does not publish one."
    ]
  },
  "models": {
    "gpt-4o": {
      "provider": "openai",
      "vision_support": true,
      "vision_api_endpoint": "https://api.openai.com/v1/chat/completions (same endpoint, content-type multimodal)",
      "vision_token_cost_note": "Images billed as vision tokens at the same input rate (25-1105 tokens per image depending on detail)",
      "vision_limitations": "PNG, JPEG, WEBP, GIF; up to ~20MB per image; detail low/high/auto",
      "token_limit": 128000,
      "input_cost_per_1m": 0.0025,
      "output_cost_per_1m": 0.01,
      "training_data_cutoff": "2023-10",
      "supports_streaming": true,
      "supports_function_calling": true,
