{
  "name": "ai-agent-config-manager",
  "version": "0.1.0",
  "description": "Lightweight AI Agent Configuration Manager for managing models, providers, MCP servers, and permissions across multiple AI coding agents",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "cli": "node packages/cli/dist/index.js",
    "acm": "node packages/cli/dist/index.js",
    "start": "node packages/cli/dist/index.js start",
    "stop": "node packages/cli/dist/index.js stop",
    "health": "node packages/cli/dist/index.js health",
    "gui:dev": "cd packages/gui && pnpm tauri dev",
    "gui:build": "cd packages/gui && pnpm tauri build"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0",
    "@biomejs/biome": "^1.9.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "license": "MIT",
  "allowScripts": {
    "file:../.pnpm/@biomejs+biome@1.9.4/node_modules/@biomejs/biome": true,
    "file:../../../node_modules/.pnpm/jsdom@24.1.3/node_modules/jsdom": true,
    "file:../esbuild@0.21.5/node_modules/esbuild": true,
    "file:../../tinyexec@0.3.2/node_modules/tinyexec": true,
    "file:../../whatwg-encoding@3.1.1/node_modules/whatwg-encoding": true,
    "file:../../whatwg-url@14.2.0/node_modules/whatwg-url": true,
    "file:../rollup@4.62.4/node_modules/rollup": true,
    "file:../../pathval@2.0.1/node_modules/pathval": true,
    "file:../signal-exit@4.1.0/node_modules/signal-exit": true,
    "file:../../lru-cache@10.4.3/node_modules/lru-cache": true
  }
}
